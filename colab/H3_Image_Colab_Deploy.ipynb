      "source": [
        "# MiniMax-H3-Image 高清生图（Colab + Google Drive 20TB 一键版）\n",
        "\n",
        "- **为什么走 Colab + Drive**：原版 `MiniMax-H3-Image` 权重约 140 GB，放在 20TB Drive 中 **\$0 新增存储费**，一次性拉完永久复用；A100 80GB / L4 24GB 配合逐层卸载（峰值显存 ~12.5 GB）即可直接跑 2K / 4K UHD / 5.5K 宽幅及最多 16 张参考图。\n",
        "- **Cell 1（免费 CPU 运行时即可）**：高速直拉 140 GB 权重到 `/content/drive/MyDrive/05_Colab/Models/minimax_h3_image/`（断点续传 + SHA256 校验）。\n",
        "- **Cell 2（A100 / L4 GPU 运行时）**：安装 `sglang[diffusion]` 并启动本地 `127.0.0.1:30083` 服务。\n",
        "- **Cell 3**：提交文生图 / 参考生图请求，成图直接落盘到 Drive `05_Colab/Outputs/h3_image/`。"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# === Cell 1: 挂载 Drive 并一次性拉取 MiniMax-H3-Image 权重 (~140 GB，CPU 运行时即可) ===\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import zipfile\n",
        "from pathlib import Path\n",
        "\n",
        "BUNDLE = Path('/content/drive/MyDrive/05_Colab/Workflows/h3_image/h3_image_bundle.zip')\n",
        "DST = Path('/content/drive/MyDrive/05_Colab/Models/minimax_h3_image')\n",
        "(DST / 'logs').mkdir(parents=True, exist_ok=True)\n",
        "(DST / 'models').mkdir(parents=True, exist_ok=True)\n",
        "with zipfile.ZipFile(BUNDLE, 'r') as zf:\n",
        "    for name in zf.namelist():\n",
        "        if name.startswith('remote_scripts/'):\n",
        "            target = DST / Path(name).name\n",
        "            target.write_bytes(zf.read(name))\n",
        "print('[OK] 已解压部署脚本至', DST)\n",
        "\n",
        "# 断点续传 + 24 并发拉取官方公开权重并校验 SHA256\n",
        "!python3 /content/drive/MyDrive/05_Colab/Models/minimax_h3_image/h3_download.py"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# === Cell 2: 安装 sglang[diffusion] 并启动 MiniMax-H3-Image 服务 (A100 / L4) ===\n",
        "from google.colab import drive\n",
        "import subprocess, time, urllib.request\n",
        "from pathlib import Path\n",
        "\n",
        "if not Path('/content/drive/MyDrive').exists():\n",
        "    drive.mount('/content/drive')\n",
        "\n",
        "!nvidia-smi --query-gpu=name,memory.total --format=csv,noheader\n",
        "!pip install -q -U uv && uv pip install --system -q \"sglang[diffusion]\"\n",
        "\n",
        "MODEL_PATH = '/content/drive/MyDrive/05_Colab/Models/minimax_h3_image/models/MiniMax-H3-Image'\n",
        "svc = subprocess.Popen([\n",
        "    'sglang', 'serve',\n",
        "    '--model-path', MODEL_PATH,\n",
        "    '--host', '127.0.0.1', '--port', '30083',\n",
        "    '--num-gpus', '1',\n",
        "    '--layerwise-offload-components', 'dit', 'text_encoder', 'vae',\n",
        "    '--minimax-h3-adaln-online', 'true',\n",
        "    '--dit-offload-prefetch-size', '1',\n",
        "], stdout=open('/content/h3image.log', 'w'), stderr=subprocess.STDOUT)\n",
        "\n",
        "print('正在启动 MiniMax-H3-Image 服务 (127.0.0.1:30083)...')\n",
        "for i in range(120):\n",
        "    try:\n",
        "        with urllib.request.urlopen('http://127.0.0.1:30083/health', timeout=2) as r:\n",
        "            if r.status == 200:\n",
        "                print(f'[OK] 服务已就绪 ({i*3}s)')\n",
        "                break\n",
        "    except Exception:\n",
        "        time.sleep(3)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# === Cell 3: 生成一张 2K/4K 图片并保存到 Google Drive ===\n",
        "import base64, json, time, urllib.request\n",
        "from pathlib import Path\n",
        "\n",
        "PROMPT = 'Cinematic cyberpunk rainy street in Tokyo at night, neon reflections, ultra detailed, 8k'\n",
        "SIZE = '2048x2048'  # 可选 2048x2048 (2K) / 3840x2176 (4K UHD) / 5472x3072 (5.5K)\n",
        "\n",
        "body = json.dumps({'model': 'MiniMax-H3-Image', 'prompt': PROMPT, 'size': SIZE, 'n': 1, 'response_format': 'b64_json'}).encode()\n",
        "req = urllib.request.Request('http://127.0.0.1:30083/v1/images/generations', data=body, headers={'Content-Type': 'application/json'})\n",
        "with urllib.request.urlopen(req, timeout=600) as r:\n",
        "    data = json.loads(r.read().decode())\n",
        "\n",
        "out_dir = Path('/content/drive/MyDrive/05_Colab/Outputs/h3_image')\n",
        "out_dir.mkdir(parents=True, exist_ok=True)\n",
        "out_file = out_dir / f'h3_img_{time.strftime(\"%Y%m%d_%H%M%S\")}.png'\n",
        "out_file.write_bytes(base64.b64decode(data['data'][0]['b64_json']))\n",
        "print('[OK] 已保存至:', out_file)"
      ]
    }
  ]
}
